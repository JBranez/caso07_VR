  m_Script: {fileID: 11500000, guid: 8c76bdc93fb60dd44b27791eaab14b9b, type: 3}
  m_Name: ScenarioData_LasPalmeras
  m_EditorClassIdentifier: LasPalmeras.Runtime::LasPalmeras.ScenarioData
  escenario: Escenario 07
  titulo: Agencia Las Palmeras
  bancoReceptor: "Banco Pac\xEDfico Insular"
  bancoAtacado: BANCO ANDINO
  fechas: "15 may 2015 \xB7 9 feb 2016"
  historia: "El 15 de mayo de 2015 se abren cinco cuentas ficticias con US$500 cada
    una. El 5 de febrero de 2016 llegan cerca de US$81 millones a cuatro cuentas;
    ese d\xEDa se entrega a la sucursal una caja con 20 millones de pesos. Las c\xE1maras
    no graban del 4 al 9. El 9 de febrero se ejecutan cinco transferencias por unos
    US$58,2 millones entre las 10:24 y las 11:37."
  cuentas: 5
  depositoInicialUsd: 500
  recibidoUsd: 81000000
  retiradoUsd: 58158642
  efectivoPesos: 20000000
  horaRetiro: "10:24\u201311:37"
  horaOrdenLeida: 09:11
  cuentasQueRecibenFondos: 4
  vulnerabilidades:
  - "Verificaci\xF3n de identidad d\xE9bil (KYC)"
  - Cuentas dormidas que reciben millones sin alerta
  - "C\xE1maras sin grabar y retiros sin retenci\xF3n"
  defensas:
  - "Verificaci\xF3n de identidad y domicilio"
  - Alerta por cuentas inactivas con montos grandes
  - "Retenci\xF3n de fondos y monitoreo de CCTV"
  fichas:
